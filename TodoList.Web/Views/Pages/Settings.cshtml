@{
ViewData["Title"] = "Settings";
}

@section Styles { <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
}

<div class="settings-page">

<div class="settings-header">
    <div>
        <p class="eyebrow">ACCOUNT SETTINGS</p>
        <h1>Settings</h1>
        <p class="settings-subtitle">
            Manage your Taskora preferences and account settings.
        </p>
    </div>
</div>

<div class="settings-layout">

    <!-- Appearance -->
    <section class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon">🎨</div>
            <div>
                <h2>Appearance</h2>
                <p>Customize how Taskora looks for you.</p>
            </div>
        </div>

        <div class="settings-option">
            <div>
                <h3>Theme</h3>
                <p>Choose your preferred appearance.</p>
            </div>

            <select id="themeSelect" class="settings-select">
                <option value="light">Light</option>
                <option value="dark">Dark</option>
                <option value="system">System Default</option>
            </select>
        </div>
    </section>

    <!-- Notifications -->
    <section class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon">🔔</div>
            <div>
                <h2>Notifications</h2>
                <p>Control how you receive task reminders.</p>
            </div>
        </div>

        <div class="settings-option">
            <div>
                <h3>Task reminders</h3>
                <p>Receive reminders about upcoming tasks.</p>
            </div>

            <label class="toggle">
                <input id="showCompleted" type="checkbox" checked />
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="settings-option">
            <div>
                <h3>Overdue task alerts</h3>
                <p>Get notified when a task becomes overdue.</p>
            </div>

            <label class="toggle">
                <input type="checkbox" checked />
                <span class="toggle-slider"></span>
            </label>
        </div>
    </section>

    <!-- Task Preferences -->
    <section class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon">✓</div>
            <div>
                <h2>Task Preferences</h2>
                <p>Choose how your tasks are displayed.</p>
            </div>
        </div>

        <div class="settings-option">
            <div>
                <h3>Default task priority</h3>
                <p>Priority automatically selected for new tasks.</p>
            </div>

            <select id="defaultPriority" class="settings-select">
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
            </select>
        </div>

        <div class="settings-option">
            <div>
                <h3>Show completed tasks</h3>
                <p>Display completed tasks in your task list.</p>
            </div>

            <label class="toggle">
                <input type="checkbox" checked />
                <span class="toggle-slider"></span>
            </label>
        </div>
    </section>

    <!-- Account -->
    <section class="settings-card">
        <div class="settings-card-header">
            <div class="settings-icon">👤</div>
            <div>
                <h2>Account</h2>
                <p>Manage your Taskora account.</p>
            </div>
        </div>

        <div class="account-actions">
            <a href="/account/profile" class="settings-button secondary">
                Edit Profile
            </a>

            <a href="/account/logout" class="settings-button danger">
                Log Out
            </a>
        </div>
    </section>

</div>
</div>

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}