@{
    ViewData["Title"] = "Add Task";
}

@section Styles {
    <link rel="stylesheet" href="~/css/add-task.css" asp-append-version="true" />
}

<div class="task-page">

    <div class="task-page-header">
        <div>
            <p class="eyebrow">TASK MANAGEMENT</p>

            <h1>Add New Task</h1>

            <p class="task-page-subtitle">
                Create a task and keep your work organized.
            </p>
        </div>

        <a href="/tasks" class="secondary-button">
            Cancel
        </a>
    </div>


    <div class="task-form-card">

        <div class="task-form-header">

            <div class="form-icon">+</div>

            <div>
                <h2>Task Details</h2>

                <p>
                    Enter the information for your new task.
                </p>
            </div>

        </div>


        <form method="post" action="/tasks/add">

            <!-- Task Title -->
            <div class="form-group">

                <label for="title">
                    Task Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    placeholder="e.g. Complete CSE 325 project"
                    autocomplete="off"
                    required />

            </div>


            <!-- Description -->
            <div class="form-group">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    placeholder="Add details about this task..."
                    required></textarea>

                <span class="form-help">
                    Provide a short description to help you remember what needs to be done.
                </span>

            </div>


            <!-- Category and Priority -->
            <div class="form-row">

                <!-- Category -->
                <div class="form-group">

                    <label for="category">
                        Category
                    </label>

                    <select
                        id="category"
                        name="category"
                        required>

                        <option value="">
                            Select category
                        </option>

                        <option value="1">
                            Work
                        </option>

                        <option value="2">
                            Home / Chores
                        </option>

                        <option value="3">
                            Church Calling
                        </option>

                        <option value="4">
                            School
                        </option>

                    </select>

                </div>


                <!-- Priority -->
                <div class="form-group">

                    <label for="priority">
                        Priority
                    </label>

                    <select
                        id="priority"
                        name="priority"
                        required>

                        <option value="">
                            Select priority
                        </option>

                        <option value="10">
                            High
                        </option>

                        <option value="5">
                            Medium
                        </option>

                        <option value="1">
                            Low
                        </option>

                    </select>

                </div>

            </div>


            <!-- Due Date -->
            <div class="form-group">

                <label for="dueDate">
                    Due Date
                </label>

                <input
                    type="date"
                    id="dueDate"
                    name="dueDate"
                    required />

            </div>


            <!-- Form Footer -->
            <div class="task-form-footer">

                <a href="/tasks" class="secondary-button">
                    Cancel
                </a>

                <button
                    type="submit"
                    class="primary-button">

                    <span>+</span>

                    Create Task

                </button>

            </div>

        </form>

    </div>

</div>