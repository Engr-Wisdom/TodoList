@{
    ViewData["Title"] = "Home / Chores";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
}   

<div class="category-page">
    <div class="category-page-header">
        <div>
            <div class="category-title-row">
                <span class="large-category-dot category-home"></span>
                <h1>Home / Chores</h1>
            </div>

            <p class="page-subtitle">
                Keep track of household tasks and personal responsibilities.
            </p>
        </div>

        <a href="#" class="primary-button">
            <span>+</span>
            Add Task
        </a>
    </div>

    <div class="category-overview">
        <div>
            <span>Tasks</span>
            <strong>4</strong>
        </div>

        <div>
            <span>Active</span>
            <strong>2</strong>
        </div>

        <div>
            <span>Completed</span>
            <strong>2</strong>
        </div>
    </div>

    <div class="category-task-list">

        <article class="category-task-card">
            <div class="category-task-check"></div>

            <div class="category-task-content">
                <h3>Buy groceries</h3>
                <p>
                    Purchase groceries and household supplies for the week.
                </p>

                <div class="task-meta">
                    <span class="priority-badge medium">Medium</span>
                    <span class="task-date">Due Sep 28, 2026</span>
                </div>
            </div>

            <div class="task-actions">
                <button type="button">✎</button>
                <button type="button">×</button>
            </div>
        </article>

        <article class="category-task-card">
            <div class="category-task-check"></div>

            <div class="category-task-content">
                <h3>Clean the apartment</h3>
                <p>
                    Clean the living room, bedroom, and kitchen.
                </p>

                <div class="task-meta">
                    <span class="priority-badge low">Low</span>
                    <span class="task-date">Due Sep 29, 2026</span>
                </div>
            </div>

            <div class="task-actions">
                <button type="button">✎</button>
                <button type="button">×</button>
            </div>
        </article>

        <article class="category-task-card completed-task">
            <div class="category-task-check checked">✓</div>

            <div class="category-task-content">
                <h3>Wash clothes</h3>
                <p>
                    Complete the weekly laundry.
                </p>

                <div class="task-meta">
                    <span class="priority-badge low">Low</span>
                    <span class="completed-label">Completed</span>
                </div>
            </div>
        </article>

    </div>
</div>