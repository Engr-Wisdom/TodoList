@{
    ViewData["Title"] = "School";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
}

<div class="category-page">
    <div class="category-page-header">
        <div>
            <div class="category-title-row">
                <span class="large-category-dot category-school"></span>
                <h1>School</h1>
            </div>

            <p class="page-subtitle">
                Stay organized with assignments, projects, and study tasks.
            </p>
        </div>

        <a href="#" class="primary-button">
            <span>+</span>
            Add Task
        </a>
    </div>

    <div class="category-overview">
        <div>
            <span>Tasks</span>
            <strong>5</strong>
        </div>

        <div>
            <span>Active</span>
            <strong>3</strong>
        </div>

        <div>
            <span>Completed</span>
            <strong>2</strong>
        </div>
    </div>

    <div class="category-task-list">

        <article class="category-task-card">
            <div class="category-task-check"></div>

            <div class="category-task-content">
                <h3>Complete CSE 325 project proposal</h3>
                <p>
                    Finish the project proposal and prepare it for submission.
                </p>

                <div class="task-meta">
                    <span class="priority-badge high">High</span>
                    <span class="task-date">Due Sep 30, 2026</span>
                </div>
            </div>

            <div class="task-actions">
                <button type="button">✎</button>
                <button type="button">×</button>
            </div>
        </article>

        <article class="category-task-card">
            <div class="category-task-check"></div>

            <div class="category-task-content">
                <h3>Study ASP.NET MVC</h3>
                <p>
                    Review controllers, views, routing, and Razor syntax.
                </p>

                <div class="task-meta">
                    <span class="priority-badge medium">Medium</span>
                    <span class="task-date">Due Oct 1, 2026</span>
                </div>
            </div>

            <div class="task-actions">
                <button type="button">✎</button>
                <button type="button">×</button>
            </div>
        </article>

        <article class="category-task-card overdue-task">
            <div class="category-task-check"></div>

            <div class="category-task-content">
                <h3>Submit weekly assignment</h3>
                <p>
                    Submit the required weekly assignment through the course portal.
                </p>

                <div class="task-meta">
                    <span class="priority-badge high">High</span>
                    <span class="overdue-label">Overdue · Sep 22, 2026</span>
                </div>
            </div>

            <div class="task-actions">
                <button type="button">✎</button>
                <button type="button">×</button>
            </div>
        </article>

    </div>
</div>