@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">

    <div class="auth-card">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="auth-success-toast">
                <span class="toast-icon">✓</span>

                <span>
                    @TempData["SuccessMessage"]
                </span>
            </div>
        }

        <div class="auth-header">

            <div class="brand-mark">
                T
            </div>

            <h1>
                Welcome back
            </h1>

            <p>
                Log in to your Taskora account to continue.
            </p>

        </div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       placeholder="Enter your email"
                       required />

                @if (ViewData.ModelState["email"]?.Errors.Count > 0)
                {
                    <span class="field-validation-error">
                        @ViewData.ModelState["email"]?.Errors[0].ErrorMessage
                    </span>
                }

            </div>

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       placeholder="Enter your password"
                       required />

                @if (ViewData.ModelState["password"]?.Errors.Count > 0)
                {
                    <span class="field-validation-error">
                        @ViewData.ModelState["password"]?.Errors[0].ErrorMessage
                    </span>
                }

            </div>

            <button type="submit"
                    class="primary-button auth-button">
                Log In
            </button>

        </form>

        <div class="auth-footer">

            <span>
                Don't have an account?
            </span>

            <a asp-controller="Account"
               asp-action="Register">
                Create an account
            </a>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
}